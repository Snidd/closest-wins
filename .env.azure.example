# Settings for compose.azure.yaml (a public VM with HTTPS). Copy to .env.azure (git-ignored)
# on the server and fill in.

# The DNS name of the server, without https://. It must already point at the VM's public
# address: Caddy asks Let's Encrypt for its certificate on the first start. Either your own
# name (an A record) or the Azure one that scripts/azure/create-vm.sh prints.
DOMAIN=game.example.com

# The one shared admin password (admin UI and hosting). The login page is open to the
# internet here: use a long one.
ADMIN_PASSWORD=

# Signs the admin session cookie (at least 32 characters): openssl rand -hex 32
SESSION_SECRET=

# Bearer token for the MCP endpoint (/mcp, at least 16 characters): openssl rand -hex 24
MCP_TOKEN=

# Postgres. Only reachable inside the compose network.
POSTGRES_PASSWORD=

# 1 adds the sample content (16 locations, 2 playlists) on start.
SEED_SAMPLE_CONTENT=1
