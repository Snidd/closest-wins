# Postgres connection string. The dev database from compose.yaml listens on host port 5433.
DATABASE_URL="postgres://root:mysecretpassword@localhost:5433/local"

# The single shared admin password. Unlocks /admin and hosting at /host.
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie (HMAC-SHA256). At least 32 characters.
# Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-64-hex-chars"

# Bearer token for the MCP endpoint (/mcp). Separate from the admin password.
# Generate with: openssl rand -hex 24
MCP_TOKEN="replace-with-random-token"

# Directory for runtime data: DATA_DIR/media (photos) and DATA_DIR/map/world.pmtiles. Default ./data
DATA_DIR="./data"

# Public origin of the app, used to build QR / join URLs (and by adapter-node for CSRF checks).
ORIGIN="http://localhost:5173"
