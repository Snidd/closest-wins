{
	"name": "closest-wins",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:lan": "node --env-file-if-exists=.env scripts/dev-lan.ts",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"test": "pnpm test:unit && pnpm test:e2e",
		"seed": "node --env-file-if-exists=.env scripts/seed.ts",
		"migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
		"tvos:export": "node scripts/export-tvos.ts",
		"tvos:fixtures": "TVOS_FIXTURES=1 vitest run src/lib/server/game/tvos-fixtures.test.ts",
		"db:start": "docker compose up -d db",
		"db:stop": "docker compose stop db",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"map": "scripts/fetch-map.sh"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26",
		"@types/qrcode": "^1.5.6",
		"drizzle-kit": "^0.31.10",
		"maplibre-gl": "^6.18.0",
		"pmtiles": "^4.5.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"bonjour-service": "^1.4.4",
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"sharp": "^0.35.5",
		"valibot": "^1.5.0",
		"zod": "^4.6.7"
	}
}
