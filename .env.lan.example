# Settings for compose.lan.yaml (home network). Copy to .env.lan (git-ignored) and fill in, or
# enter the same names as environment variables of a Portainer stack.

# The address phones, the host and the TV open; the QR code is built from it.
# Directly: this server's address on your network with the port below (give the server a fixed
# address in your router).
ORIGIN=http://192.168.1.50:3000
# Through a reverse proxy with a local DNS name (e.g. Nginx Proxy Manager): its https:// name,
# and the header the proxy puts the client address in.
# ORIGIN=https://closestwins.example.com
# ADDRESS_HEADER=X-Forwarded-For

# The one shared admin password (admin UI and hosting).
ADMIN_PASSWORD=change-me-to-something-long

# Signs the admin session cookie (at least 32 characters): openssl rand -hex 32
SESSION_SECRET=

# Bearer token for the MCP endpoint (/mcp, at least 16 characters): openssl rand -hex 24
MCP_TOKEN=

# Postgres. Only reachable from the server itself (127.0.0.1:DB_PORT).
POSTGRES_PASSWORD=

# 1 adds the sample content (16 locations, 2 playlists) on start.
SEED_SAMPLE_CONTENT=1

# Ports on the server: the game, and Postgres on the loopback interface.
# APP_PORT=3000
# DB_PORT=5434

# 0 turns off the Bonjour advertisement for the Apple TV app.
# MDNS_ADVERTISE=1
