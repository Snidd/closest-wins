# Production settings for compose.prod.yaml. Copy to .env.production (git-ignored) and fill in.

# Public URL players and the TV use. Join links and the QR code are built from it, and form
# posts are only accepted from this origin. With https:// the cookies are marked Secure.
ORIGIN=https://game.example.com

# The one shared admin password (admin UI and hosting).
ADMIN_PASSWORD=change-me-to-something-long

# Signs the admin session cookie (at least 32 characters): openssl rand -hex 32
SESSION_SECRET=

# Bearer token for the MCP endpoint (/mcp, at least 16 characters): openssl rand -hex 24
MCP_TOKEN=

# Postgres (the db service; not published outside the compose network).
POSTGRES_PASSWORD=
# POSTGRES_USER=closestwins
# POSTGRES_DB=closestwins

# Host port and interface of the app. Behind a reverse proxy on the same machine, bind to
# 127.0.0.1 so only the proxy can reach it.
# APP_PORT=3000
# APP_BIND=127.0.0.1

# Behind a reverse proxy: read the client address from this header, or the login and join
# rate limits see every client as the proxy. XFF_DEPTH = number of proxies you trust.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# BODY_SIZE_LIMIT=16M
