# HTTPS front for compose.azure.yaml. Caddy gets and renews the Let's Encrypt certificate for
# DOMAIN and redirects http:// to https://.
#
# Deliberately no `encode`: the app serves its static assets precompressed, the map file must
# not be compressed again (it is read with Range requests), and the live game updates are
# long-lived event streams that compression would buffer.
{
	# Only TCP 80 and 443 are published and open in the firewall: do not advertise HTTP/3.
	servers {
		protocols h1 h2
	}
}

{$DOMAIN} {
	# Photo uploads are up to 15 MB.
	request_body {
		max_size 16MB
	}

	reverse_proxy app:3000 {
		# Write every chunk through at once: the live updates must not wait in a buffer.
		flush_interval -1
	}
}
